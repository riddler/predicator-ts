
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Local beads telemetry churn; the tracker syncs via refs/dolt/data.
.beads/interactions.jsonl

# Changelog fragments are tracked. A global gitignore rule for `*.d` (C/C++
# dependency files) matches this directory name and would otherwise hide them.
!changelog.d/

# Node / TypeScript build output.
node_modules/
dist/
coverage/
reports/

# Temporary files, for example, from tests.
/tmp/
